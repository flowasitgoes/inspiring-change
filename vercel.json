{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/work",
      "dest": "/work.html"
    },
    {
      "src": "/service",
      "dest": "/service.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    }
  ]
} 